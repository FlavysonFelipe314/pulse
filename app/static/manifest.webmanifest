{
  "name": "Pulse — sua música",
  "short_name": "Pulse",
  "description": "Sua biblioteca pessoal de música, playlists e descobertas.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": {"client_mode": "navigate-existing"},
  "orientation": "any",
  "background_color": "#09090d",
  "theme_color": "#0b0b10",
  "lang": "pt-BR",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    {"src": "/static/images/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/static/images/app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Pesquisar", "short_name": "Pesquisar", "url": "/?view=search", "icons": [{"src": "/static/images/app-icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Biblioteca", "short_name": "Biblioteca", "url": "/?view=library", "icons": [{"src": "/static/images/app-icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ]
}
